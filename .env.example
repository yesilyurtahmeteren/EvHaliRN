# Kopyala: cp .env.example .env
# EXPO_PUBLIC_ öneki olan değişkenler uygulama paketine gömülür ve APK'dan okunabilir.
# Buraya ASLA sır (servis hesabı, REST API anahtarı vb.) yazma (CLAUDE.md §4.1).

# Google Sign-In Web client ID (Firebase Console -> Authentication -> Google).
# Herkese açık bir tanımlayıcıdır, sır değildir.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# OneSignal App ID (herkese açık tanımlayıcı, Faz 5).
EXPO_PUBLIC_ONESIGNAL_APP_ID=243eef8a-fc8d-45dc-8be3-0cdd1177ef38
